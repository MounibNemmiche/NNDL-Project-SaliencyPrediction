*.zip
*.tar
*.tar.gz
*.tgz

# ── Large outputs ─────────────────────────────────────────────────────────────
outputs/checkpoints/*.pth
outputs/logs/*.csv
outputs/plots/*.png
outputs/visualizations/*.png
# Keep the directory structure via .gitkeep
!outputs/checkpoints/.gitkeep
!outputs/logs/.gitkeep
!outputs/plots/.gitkeep
!outputs/visualizations/.gitkeep

# ── Report assets (keep only small committed files) ───────────────────────────
report_assets/qualitative_examples.png

