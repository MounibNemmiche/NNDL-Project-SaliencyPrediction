__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── Dataset — never commit images, maps, or archives ──────────────────────────
data/SALICON/train_images/
data/SALICON/val_images/
data/SALICON/test_images/
data/SALICON/train_maps/
data/SALICON/val_maps/
data/SALICON/test_maps/
